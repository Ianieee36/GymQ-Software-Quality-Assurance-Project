<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:GymQ.Desktop.ViewModels" xmlns:v="using:GymQ.Desktop.Views" x:Class="GymQ_ENSE707_SQA_Project.MainWindow" Title="GymQ" Width="430" Height="900" MinWidth="370" MinHeight="680" Background="#19191C" FontFamily="Inter, Arial">
  <Window.DataTemplates>
    <DataTemplate DataType="vm:EquipmentViewModel">
      <v:EquipmentView/>
    </DataTemplate>
    <DataTemplate DataType="vm:QueueViewModel">
      <v:QueueView/>
    </DataTemplate>
    <DataTemplate DataType="vm:SessionViewModel">
      <v:SessionView/>
    </DataTemplate>
    <DataTemplate DataType="vm:DetailViewModel">
      <v:DetailView/>
    </DataTemplate>
    <DataTemplate DataType="vm:ReportViewModel">
      <v:ReportView/>
    </DataTemplate>
    <DataTemplate DataType="vm:ProfileViewModel">
      <v:ProfileView/>
    </DataTemplate>
    <DataTemplate DataType="vm:StaffViewModel">
      <v:StaffView/>
    </DataTemplate>
    <DataTemplate DataType="vm:ClaimOverlay">
      <v:ClaimOverlayView/>
    </DataTemplate>
    <DataTemplate DataType="vm:NudgeOverlay">
      <v:NudgeOverlayView/>
    </DataTemplate>
    <DataTemplate DataType="vm:SuccessOverlay">
      <v:SuccessOverlayView/>
    </DataTemplate>
  </Window.DataTemplates>
  <Grid>
    <Grid RowDefinitions="Auto,*,Auto" IsEnabled="{Binding !HasOverlay}">
      <Border Padding="22,18,22,14" BorderBrush="#2E2E32" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="44,*,Auto">
          <Button Classes="imageButton" Command="{Binding Profile}" AutomationProperties.Name="Open profile">
            <Border Width="36" Height="36" CornerRadius="18" Background="#363137" BorderBrush="#D32A48" BorderThickness="1">
              <TextBlock Text="{Binding Initials}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
            </Border>
          </Button>
          <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
            <TextBlock Text="{Binding MemberName}" FontWeight="SemiBold" FontSize="14"/>
            <TextBlock Text="{Binding AccountRole}" Classes="micro" FontSize="8"/>
          </StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="0">
            <TextBlock Text="jetts" FontWeight="Bold" FontStyle="Italic" FontSize="23"/>
            <TextBlock Text="GYMQ" FontSize="8" LetterSpacing="2.5" Foreground="#F04A67" HorizontalAlignment="Right"/>
          </StackPanel>
        </Grid>
      </Border>
      <ScrollViewer Grid.Row="1" Name="PageScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <ContentControl Content="{Binding Page}"/>
      </ScrollViewer>
      <Border Grid.Row="2" Background="#28282C" BorderBrush="#39393E" BorderThickness="0,1,0,0" Padding="12,3,12,10">
        <UniformGrid Columns="2">
          <Button Classes="nav" Command="{Binding Equipment}">
            <StackPanel Spacing="5">
              <Path Data="M1,8 L4,8 4,4 7,4 7,10 17,10 17,4 20,4 20,8 23,8 23,16 20,16 20,20 17,20 17,14 7,14 7,20 4,20 4,16 1,16 Z" Fill="{Binding EquipmentColour}" Width="25" Height="22" Stretch="Uniform" HorizontalAlignment="Center"/>
              <TextBlock Text="Equipment" FontSize="10" Foreground="{Binding EquipmentColour}" HorizontalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Classes="nav" Command="{Binding Profile}">
            <StackPanel Spacing="5">
              <Path Data="M12,1 A5,5 0 1 1 11.99,1 Z M2,23 C2,11 22,11 22,23 Z" Fill="{Binding ProfileColour}" Width="21" Height="22" Stretch="Uniform" HorizontalAlignment="Center"/>
              <TextBlock Text="Profile" FontSize="10" Foreground="{Binding ProfileColour}" HorizontalAlignment="Center"/>
            </StackPanel>
          </Button>
        </UniformGrid>
      </Border>
    </Grid>
    <Border Background="#CC080809" IsVisible="{Binding HasOverlay}" Padding="22,26">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" VerticalAlignment="Center" MaxHeight="760">
        <ContentControl Content="{Binding Overlay}" MaxWidth="400" HorizontalAlignment="Stretch"/>
      </ScrollViewer>
    </Border>
    <Border Background="#482430" CornerRadius="10" Margin="16" Padding="12" VerticalAlignment="Top" IsVisible="{Binding HasError}">
      <Grid ColumnDefinitions="*,30">
        <TextBlock Text="{Binding Error}" Foreground="#FFB7C5" FontSize="12"/>
        <Button Grid.Column="1" Classes="quiet" Content="×" Command="{Binding DismissError}"/>
      </Grid>
    </Border>
  </Grid>
</Window>
