<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="GymQ.Desktop.Views.ProfileView">
  <StackPanel Margin="22,24" Spacing="18">
    <TextBlock Text="Profile" Classes="h1"/>
    <Border Classes="card">
      <StackPanel Spacing="6">
        <TextBlock Text="SIGNED IN AS" Classes="micro"/>
        <TextBlock Text="{Binding Name}" Classes="section"/>
        <TextBlock Text="{Binding UserName}" Classes="muted"/>
        <TextBlock Text="{Binding AccountRole}" Classes="micro"/>
      </StackPanel>
    </Border>
    <Button Content="Log out" Classes="outline" Command="{Binding LogOut}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
    <TextBlock Text="Demo controls" Classes="h2"/>
    <TextBlock Text="Advance time to test automatic timeouts without waiting. These controls affect every account. The computer clock is unchanged." Classes="muted"/>
    <Button Content="Advance demo time · 1 minute" Command="{Binding AdvanceOne}" Classes="outline"/>
    <Button Content="Advance demo time · 2 minutes" Command="{Binding AdvanceTwo}" Classes="outline"/>
    <Button Content="Advance demo time · 30 minutes" Command="{Binding AdvanceThirty}" Classes="outline"/>
    <TextBlock Text="{Binding DemoTime}" Classes="muted"/>
    <TextBlock Text="ABOUT THIS VERSION" Classes="micro"/>
    <TextBlock Text="To try another account, log out and sign in again. Data resets when you close the app." Classes="muted" FontSize="12"/>
  </StackPanel>
</UserControl>
