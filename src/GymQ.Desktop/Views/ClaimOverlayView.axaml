<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="GymQ.Desktop.Views.ClaimOverlayView">
  <Border Background="#202023" BorderBrush="#D63252" BorderThickness="1.5" CornerRadius="24" Padding="24,30">
    <StackPanel Spacing="19">
      <TextBlock Text="YOUR TURN" Classes="h1 center" Foreground="#F03255"/>
      <Image Source="{Binding Image}" Height="165"/>
      <TextBlock Text="{Binding Name,StringFormat='{}{0} is ready'}" Classes="h2 center"/>
      <TextBlock Text="You have 2 minutes to claim the equipment before it is offered to the next member." Classes="center" Foreground="#C7C7CD"/>
      <Button Content="CLAIM MACHINE" Classes="primary" Command="{Binding Claim}" Margin="0,8,0,0"/>
      <Button Content="LEAVE QUEUE" Classes="link" Command="{Binding Leave}"/>
      <TextBlock Text="{Binding Countdown}" Classes="muted center"/>
    </StackPanel>
  </Border>
</UserControl>
