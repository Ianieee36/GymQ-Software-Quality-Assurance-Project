<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="#F5F4F4"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="29"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="LetterSpacing" Value="-0.7"/>
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="22"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="LetterSpacing" Value="-0.4"/>
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="17"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="#A4A4AC"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>
  <Style Selector="TextBlock.micro">
    <Setter Property="Foreground" Value="#919298"/>
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="LetterSpacing" Value="1.2"/>
  </Style>
  <Style Selector="TextBlock.center">
    <Setter Property="TextAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button">
    <Setter Property="Background" Value="#2D2D32"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="CornerRadius" Value="9"/>
    <Setter Property="Padding" Value="16,12"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="#E92046"/>
    <Setter Property="MinHeight" Value="44"/>
  </Style>
  <Style Selector="Button.outline">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="#85858B"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="Button.link">
    <Setter Property="Foreground" Value="#F05270"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="8"/>
  </Style>
  <Style Selector="Button.quiet">
    <Setter Property="Foreground" Value="#ADADB4"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="8"/>
  </Style>
  <Style Selector="Button.imageButton">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="4,8"/>
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#404046"/>
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#FA365B"/>
  </Style>
  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.4"/>
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="#202023"/>
    <Setter Property="BorderBrush" Value="#39393D"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="Padding" Value="16"/>
  </Style>
  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1"/>
    <Setter Property="Background" Value="#353539"/>
  </Style>
  <Style Selector="TextBox">
    <Setter Property="Background" Value="#29292E"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderBrush" Value="#4A4A50"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Padding" Value="16"/>
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="#26262B"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderBrush" Value="#47474E"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>
</Styles>
