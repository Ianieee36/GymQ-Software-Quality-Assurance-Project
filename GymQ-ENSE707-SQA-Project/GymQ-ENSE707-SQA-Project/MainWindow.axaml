<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GymQ_ENSE707_SQA_Project.MainWindow"
        Title="GymQ Project"
        Width="900" Height="600">

    <Grid RowDefinitions="Auto,*" Margin="10">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
            <TextBlock Text="GymQ - Machines" FontSize="18" FontWeight="Bold" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,0,0,0">
                <Button x:Name="ToggleStaffButton" Content="Staff View" Margin="8,0" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="2*,3*" Margin="0,10,0,0">
            <!-- Machines list -->
            <Border Background="#f3f3f3" CornerRadius="4" Padding="6">
                <StackPanel>
                    <TextBlock Text="Machines" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ListBox x:Name="EquipmentListBox" Height="460" />
                </StackPanel>
            </Border>

            <!-- Details / actions -->
            <Border Background="#ffffff" CornerRadius="4" Padding="10">
                <StackPanel Spacing="8">
                    <TextBlock Text="Machine Details" FontWeight="SemiBold" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Name:" Width="80" />
                        <TextBlock x:Name="NameText" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Status:" Width="80" />
                        <TextBlock x:Name="StatusText" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="In Queue:" Width="80" />
                        <TextBlock x:Name="QueueCountText" />
                    </StackPanel>

                    <Button x:Name="JoinQueueButton" Content="Join Queue" Width="120" />

                    <Separator />

                    <Button x:Name="ToggleReportButton" Content="Report an Issue" Width="140" />

                    <StackPanel x:Name="ReportPanel" IsVisible="False">
                        <TextBlock Text="Report an Issue" FontWeight="SemiBold" />
                        <TextBox x:Name="ReportDescriptionBox" AcceptsReturn="True" Height="100" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ReportButton" Content="Submit Report" Width="120" />
                            <TextBlock x:Name="ReportResultText" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <Separator />

                    <StackPanel x:Name="StaffPanel" IsVisible="False" Spacing="6">
                        <TextBlock Text="Staff - Pending Reports" FontWeight="SemiBold" />
                        <ListBox x:Name="PendingReportsListBox" Height="140" />
                        <TextBlock x:Name="PendingReportDetailsText" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ConfirmReportButton" Content="Confirm" Width="100" />
                            <Button x:Name="RejectReportButton" Content="Reject" Width="100" />
                        </StackPanel>
                    </StackPanel>

                    <Separator />

                    <TextBlock Text="Messages" FontWeight="SemiBold" />
                    <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
