<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GymQ_ENSE707_SQA_Project.MainWindow"
        Title="GymQ Project"
        Width="820" Height="620">

    <Grid RowDefinitions="Auto,*" Margin="20">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,15">
            <TextBlock Grid.Column="0"
                       Text="GymQ - Machines"
                       FontSize="24" FontWeight="Bold"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="1"
                    Name="ToggleStaffButton"
                    Content="Staff View"/>
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="1" ColumnDefinitions="300,*">

            <!-- Equipment list (left column) -->
            <ListBox Grid.Column="0"
                     Name="EquipmentListBox"
                     Width="280"
                     Height="200"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"/>

            <!-- Right column: member view + staff view stacked -->
            <StackPanel Grid.Column="1" Margin="20,0,0,0" Spacing="15">

                <!-- Machine details (member view) -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Machine Details" FontSize="18" FontWeight="Bold"/>
                    <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Name="NameText"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Status:"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Name="StatusText"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="In Queue:"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Name="QueueCountText"/>
                    </Grid>
                </StackPanel>

                <Button Name="JoinQueueButton" Content="Join Queue" HorizontalAlignment="Left"/>

                <Separator/>

                <Button Name="ToggleReportButton" Content="Report an Issue" HorizontalAlignment="Left"/>

                <!-- Report panel (collapsed by default) -->
                <StackPanel Name="ReportPanel" IsVisible="False" Spacing="8">
                    <TextBlock Text="Report an Issue" FontSize="16" FontWeight="Bold"/>
                    <TextBox Name="ReportDescriptionBox"
                             Watermark="Describe the problem"
                             AcceptsReturn="True"
                             Height="80"/>
                    <Button Name="ReportButton" Content="Submit Report" HorizontalAlignment="Left"/>
                    <TextBlock Name="ReportResultText" Foreground="OrangeRed"/>
                </StackPanel>

                <Separator/>

                <StackPanel Spacing="4">
                    <TextBlock Text="Messages" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Name="MessageText" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Staff panel (collapsed by default) -->
                <StackPanel Name="StaffPanel" IsVisible="False" Spacing="8">
                    <TextBlock Text="Staff - Pending Reports" FontSize="18" FontWeight="Bold"/>
                    <ListBox Name="PendingReportsListBox" Height="150"/>
                    <TextBlock Name="PendingReportDetailsText" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Name="ConfirmReportButton" Content="Confirm" IsEnabled="False"/>
                        <Button Name="RejectReportButton" Content="Reject" IsEnabled="False"/>
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </Grid>
    </Grid>
</Window>